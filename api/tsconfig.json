/* Configuração da função serverless (Node na Vercel), separada da do Angular. */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noPropertyAccessFromIndexSignature": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/app/shared/**/*.ts"],
  "exclude": ["../src/**/*.spec.ts"]
}
